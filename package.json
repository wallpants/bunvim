{
  "name": "bunvim",
  "version": "0.0.0",
  "description": "Neovim bun client",
  "license": "MIT",
  "author": "wallpants",
  "repository": {
    "type": "git",
    "url": "git://github.com/wallpants/bunvim.git"
  },
  "bin": {
    "bunvim": "src/cli/index.ts"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/test-utils",
    "!src/tests.ts"
  ],
  "type": "module",
  "exports": {
    "types": "./src/index.ts",
    "bun": "./src/index.ts"
  },
  "scripts": {
    "commit": "cz",
    "vi": "nvim",
    "format": "oxfmt .",
    "lint": "oxlint .",
    "test": "bun test",
    "typecheck": "tsc",
    "check": "bun run typecheck && bun run lint"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "msgpackr": "^2.0.4",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^21.2.0",
    "@commitlint/cz-commitlint": "^21.2.0",
    "@types/bun": "1.3.14",
    "commitizen": "^4.3.2",
    "commitlint": "^21.2.1",
    "inquirer": "^12.11.1",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.73.0",
    "oxlint-tsgolint": "^0.25.0",
    "semantic-release": "^25.0.8",
    "typescript": "7.0.2"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "body-max-line-length": [
        0
      ]
    }
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  },
  "release": {
    "branches": [
      "main"
    ]
  }
}
