{
  "name": "bunvim",
  "version": "0.0.0",
  "description": "Neovim bun client",
  "license": "MIT",
  "author": "wallpants",
  "repository": {
    "type": "git",
    "url": "git://github.com/wallpants/bunvim.git"
  },
  "bin": {
    "bunvim": "src/cli/index.ts"
  },
  "type": "module",
  "exports": {
    "types": "./src/index.ts",
    "bun": "./src/index.ts"
  },
  "scripts": {
    "commit": "cz",
    "vi": "nvim",
    "format": "oxfmt .",
    "lint": "eslint .",
    "typecheck": "tsc",
    "check": "bun run typecheck && bun run lint"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "msgpackr": "^2.0.2",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^21.0.2",
    "@commitlint/cz-commitlint": "^21.0.2",
    "@types/bun": "1.3.14",
    "@types/eslint": "^9.6.1",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "commitizen": "^4.3.1",
    "commitlint": "^21.0.2",
    "eslint": "^9.39.4",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.2",
    "inquirer": "^12.11.1",
    "oxfmt": "^0.52.0",
    "semantic-release": "^25.0.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "body-max-line-length": [
        0
      ]
    }
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  },
  "release": {
    "branches": [
      "main"
    ]
  }
}
